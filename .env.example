# Anthropic API key (https://console.anthropic.com). Needed for the AI assistant, drafting and the order reader.
ANTHROPIC_API_KEY=

# Indian Kanoon API token (https://api.indiankanoon.org). Needed for judgment search and citation verification.
# New accounts get Rs 500 credit; non-commercial users can apply for Rs 10,000/month.
INDIANKANOON_API_TOKEN=

# Optional overrides
# ENKLAW_MODEL=claude-opus-5
# PORT=8787

# Required when the server is reachable from the internet (e.g. for the phone apps):
# the apps must send this code (Settings → EnkLaw server → Access code).
# ENKLAW_ACCESS_TOKEN=choose-a-long-random-code
# Extra browser origins allowed to call the API, comma-separated (the Android/iOS apps are allowed already).
# ENKLAW_ALLOWED_ORIGINS=https://enklaw.yourdomain.in
